<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.flash.bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>node</string>
        <string>bot/index.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/a/Desktop/FLASH</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- NODE_ENV is not strictly needed, but harmless for clarity -->
        <key>NODE_ENV</key>
        <string>production</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/a/Desktop/FLASH/logs/bot.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/a/Desktop/FLASH/logs/bot.err.log</string>
</dict>
</plist>